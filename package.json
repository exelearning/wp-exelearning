{
  "name": "wp-exelearning",
  "version": "1.0.0",
  "description": "WordPress plugin for eXeLearning integration",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@wordpress/blocks": "^15.26.0",
    "@wordpress/components": "^39.0.0",
    "@wordpress/element": "^8.4.0",
    "@wordpress/env": "^11.13.0",
    "@wordpress/i18n": "^6.26.0",
    "happy-dom": "^20.11.2",
    "jquery": "^3.7.1",
    "nunjucks": "^3.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "wp-env": "wp-env",
    "composer": "wp-env run cli --env-cwd=wp-content/plugins/exelearning composer",
    "composer:tests-cli": "wp-env run tests-cli --env-cwd=wp-content/plugins/exelearning composer",
    "test:unit": "wp-env run tests-cli --env-cwd=wp-content/plugins/exelearning ./vendor/bin/phpunit",
    "test:js": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build": "echo 'Use make build-editor instead for static editor build'",
    "package": "npm run package:zip",
    "package:zip": "git archive --format=zip --output=wp-exelearning.zip HEAD",
    "package:zip:full": "zip -r wp-exelearning-full.zip . -x 'node_modules/*' -x '.git/*' -x '*.zip' -x '.DS_Store'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exelearning/wp-exelearning"
  },
  "author": "eXeLearning",
  "license": "GPL-3.0-or-later",
  "overrides": {
    "@wp-playground/cli": "3.1.13"
  }
}
