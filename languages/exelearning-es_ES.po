msgid "eXeLearning Settings"
msgstr "Ajustes de eXeLearning"

#: admin/class-admin-settings.php
msgid "Overview"
msgstr "Vista general"

#: admin/class-admin-settings.php
msgid "The embedded editor is required to edit eXeLearning files."
msgstr "El editor integrado es necesario para editar archivos eXeLearning."

#: admin/class-admin-settings.php
msgid "This installation does not include it: official release packages ship the editor, so please reinstall the plugin from a release package (or build it with \"make build-editor\" in a development checkout)."
msgstr "Esta instalación no lo incluye: los paquetes de las versiones oficiales ya llevan el editor, así que reinstala el plugin desde un paquete de versión (o compílalo con «make build-editor» en una copia de desarrollo)."

#: admin/class-admin-settings.php
msgid "Embed an uploaded .elpx package anywhere with the [exelearning] shortcode, referencing the file by its Media Library attachment ID."
msgstr "Incrusta un paquete .elpx subido en cualquier lugar con el código corto [exelearning], referenciando el archivo por su ID de adjunto en la Biblioteca de medios."

#: admin/class-admin-settings.php
msgid "The full attribute reference is available at the bottom of this page."
msgstr "La referencia completa de atributos está disponible al final de esta página."

#: admin/class-admin-settings.php
