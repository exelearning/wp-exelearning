#: admin/class-admin-settings.php:212
msgid ""
"The shortcode output can be customized with the exelearning_shortcode_atts, "
"exelearning_preview_url, and exelearning_shortcode_output filters, among "
"other actions and filters."
msgstr ""
"L'output dello shortcode può essere personalizzato con i filtri "
"exelearning_shortcode_atts, exelearning_preview_url ed "
"exelearning_shortcode_output, tra le altre azioni e filtri."

